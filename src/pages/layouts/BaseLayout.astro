---
import Navbar from "../navbar.astro";
import Footer from "../footer.astro";
import '@/styles/main.scss';
import '@/styles/theme.scss';
import { translations } from '../../lib/i18n';

const base = import.meta.env.BASE_URL;

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kasper Laine — Full-Stack Developer Portfolio",
  description = "Full-Stack Developer Portfolio. Experienced web developer specializing in React, WordPress, PHP, and modern web technologies. Based in Helsinki.",
} = Astro.props;

const translationsJson = JSON.stringify(translations);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="full-stack developer, React, WordPress, PHP, web development, Helsinki, portfolio"
    />
    <meta name="author" content="Kasper Laine" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://MWxzy.github.io/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://MWxzy.github.io/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <link rel="canonical" href="https://MWxzy.github.io/" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}favicon.ico`} />
  </head>

  <body>
    <Navbar />

    <main>
      <slot />
    </main>

    <Footer />

    <script is:inline define:vars={{ translationsJson }}>
      const translations = JSON.parse(translationsJson);

      if (!localStorage.getItem("language")) {
        localStorage.setItem("language", "en");
      }

      function applyTranslations() {
        const lang = localStorage.getItem("language") || "en";

        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (!key) return;

          const value = translations[lang]?.[key];

          if (value) {
            el.textContent = value;
          }
        });
      }

      const theme = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", theme);

      applyTranslations();

      window.addEventListener("languageChanged", () => {
        applyTranslations();
      });
    </script>

    <script is:inline>
      class PortfolioAnimations {
        constructor() {
          this.init();
        }
        
        init() {
          this.setupScrollReveal();
          this.setupParallax();
          this.setupCardHovers();
          this.observeNewCards();
        }
        
        setupScrollReveal() {
          const revealElements = document.querySelectorAll('.scroll-reveal');
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
          revealElements.forEach(el => observer.observe(el));
        }
        
        setupParallax() {
          const parallaxElements = document.querySelectorAll('[data-parallax]');
          if (parallaxElements.length === 0) return;
          window.addEventListener('scroll', () => {
            parallaxElements.forEach(el => {
              const speed = parseFloat(el.getAttribute('data-parallax') || '0.5');
              el.style.transform = `translateY(${window.scrollY * speed}px)`;
            });
          });
        }
        
        setupCardHovers() {
          const cards = document.querySelectorAll('.pixel-card, .blog-card, .small-card, .large-card, .contact-card, .experience-item, .about-section');
          cards.forEach(card => {
            card.addEventListener('mouseenter', () => {
              card.classList.add('animate-border-glow');
            });
            card.addEventListener('mouseleave', () => {
              card.classList.remove('animate-border-glow');
            });
          });
        }

        observeNewCards() {
          const observer = new MutationObserver(() => {
            this.setupCardHovers();
          });
          
          const projectContainers = document.querySelectorAll(
            '#workProjectsContainer, #personalProjectsContainer, #groupProjectsContainer'
          );
          
          projectContainers.forEach(container => {
            observer.observe(container, { childList: true, subtree: true });
          });
        }
      }
      
      new PortfolioAnimations();
      
      window.addEventListener('languageChanged', () => {
        setTimeout(() => {
          new PortfolioAnimations();
        }, 100);
      });
    </script>
  </body>
</html>
